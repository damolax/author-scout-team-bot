TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
DATABASE_URL=
APP_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MAX_FIND_COUNT=30
REQUEST_TIMEOUT=12
TIMEZONE_NAME=Africa/Lagos

# Author Scout v3.1 speed controls
AUTHOR_RESEARCH_CONCURRENCY=10
RESEARCH_CACHE_HOURS=24
SEARCH_CACHE_HOURS=6
SEARCH_PRIMARY_BACKEND=bing
SEARCH_FALLBACK_BACKEND=duckduckgo
HTTP_MAX_CONNECTIONS=40
HTTP_KEEPALIVE_CONNECTIONS=20

# LinkedIn Connection Intelligence
CONNECTION_READY_TARGET=100
CONNECTION_BATCH_SIZE=25
CONNECTION_RESEARCH_INTERVAL_SECONDS=180
CONNECTION_MAX_CONCURRENCY=8
CONNECTION_MIN_SCORE=65
CONNECTION_USERS_PER_CYCLE=12
CONNECTION_DISPLAY_COUNT=5
CONNECTION_GLOBAL_EXCLUSIVITY=false
CONNECTION_DEFAULT_COUNTRIES=United States,United Kingdom,Canada,Australia,Germany,France,United Arab Emirates
CONNECTION_EXCLUDED_COUNTRIES=Nigeria
# Author source index / pre-verified Neon reservoir
SOURCE_INDEX_ENABLED=true
SOURCE_INDEX_INTERVAL_SECONDS=300
SOURCE_INDEX_CONCURRENCY=8
SOURCE_INDEX_DEMANDS_PER_CYCLE=6
SOURCE_INDEX_SOURCE_PAGES_PER_DEMAND=4
SOURCE_INDEX_PREVERIFY_PER_CYCLE=16
SOURCE_INDEX_POOL_TARGET_PER_MARKET=300
SOURCE_INDEX_DEFAULT_COUNTRIES=United Kingdom,United States,Canada,Australia,France,Germany,Austria,United Arab Emirates,New Zealand,Spain,Iceland

# Letter Desk 2.0 migration rollout (enable only after new Neon schema is applied)
# Render backend flag — enables the read-only /api/v2/letterdesk endpoints.
LETTERDESK_V2_ENABLED=false
# Vercel web preview flag — unlocks the six-service dashboard tab. Vite environment variable.
# Set to true only on the Vercel PREVIEW environment until release acceptance.
VITE_LETTERDESK_V2_UI=false

# Phase 3 — dedicated service scouting, preview-only. Leave OFF until signed-in acceptance passes.
LETTERDESK_SCOUT_WRITE_ENABLED=false
# Optional official Places API (New) key; SERVER-SIDE ONLY, restrict key in Google Cloud.
# GOOGLE_PLACES_API_KEY=

# Phase 4 — imports. PREVIEW defaults to read-only; enable confirmation only after
# staging account sign-in, suppression handling and bulk import acceptance passes.
LETTERDESK_IMPORT_WRITE_ENABLED=false
# Set in Render server environment when using a distinct signing key.
# If unset, the existing long APP_SECRET signs 20-minute file preview confirmations.
# LETTERDESK_IMPORT_SIGNING_SECRET=

# Phase 5 — visual conversation drafts and revision history.
# Read-only preview supports editing in the browser, validation and simulation.
# Enable saving only after signed-in Neon staging acceptance; NEVER on production before release.
LETTERDESK_FLOW_WRITE_ENABLED=false

# Phase 6 — Gmail connections and guarded campaigns (off by default).
# Run on ISOLATED staging only until Google OAuth is configured/verified.
LETTERDESK_GMAIL_OAUTH_ENABLED=false
LETTERDESK_GMAIL_SERVER_ORIGIN=
LETTERDESK_GMAIL_FRONTEND_ORIGIN=
LETTERDESK_GMAIL_REDIRECT_URI=
# Google redirect example for STAGING only:
# LETTERDESK_GMAIL_SERVER_ORIGIN=https://letterdesk-v2-api-preview.onrender.com
# LETTERDESK_GMAIL_FRONTEND_ORIGIN=https://letterdesk-v2-ui-preview.onrender.com
# LETTERDESK_GMAIL_REDIRECT_URI=https://letterdesk-v2-api-preview.onrender.com/api/v2/letterdesk/gmail/callback
# TOKEN_ENCRYPTION_KEY must be a genuine cryptography.Fernet key (never put in frontend).
LETTERDESK_CAMPAIGN_WRITE_ENABLED=false

# Phase 6 Gmail DELIVERY: ALL THREE flags + an outside-staging deployment required.
# These must remain false until reply suppression and account verification acceptance.
LETTERDESK_GMAIL_SEND_ENABLED=false
LETTERDESK_REPLY_SAFETY_READY=false
LETTERDESK_DELIVERY_OPERATOR_APPROVED=false

# Phase 7 — reply intelligence. Review and manual ingestion are disabled
# by default until staging sign-in and privacy controls pass.
LETTERDESK_REPLY_WRITE_ENABLED=false

# Gmail readonly is a RESTRICTED scope. Requires user opt-in, verified
# Google consent screen and potential app verification/security assessment.
LETTERDESK_GMAIL_READ_OAUTH_ENABLED=false
# Never set either of these true until separate staged acceptance testing.
LETTERDESK_GMAIL_READ_ENABLED=false
# Keep Phase 6 LETTERDESK_REPLY_SAFETY_READY=false until complete
# production end-to-end delivery/reply/opt-out audit.
